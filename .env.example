# ===== Anyu Shop 生产环境变量模板 =====
# 部署：复制为 /opt/anyu/.env 并按需修改。
# 上线前务必：修改 DB_PASSWORD、用 openssl rand -hex 32 生成 JWT_ACCESS/REFRESH_SECRET！
NODE_ENV=production
PORT=3000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=anyu
DB_PASSWORD=nkYMDZimRRbRdhTJ
DB_NAME=anyu_shop
DB_CONNECTION_LIMIT=10

# Redis（redis 未设密码则 REDIS_PASSWORD 留空）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT（务必替换：openssl rand -hex 32）
JWT_ACCESS_SECRET=请用openssl随机生成
JWT_REFRESH_SECRET=请用openssl随机生成
JWT_ACCESS_EXPIRES=900
JWT_REFRESH_EXPIRES=604800

# 限流（每 IP / 15 分钟请求上限；如调试频繁可调大）
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_FAIL_LIMIT=5
LOGIN_FAIL_LOCK_MS=900000